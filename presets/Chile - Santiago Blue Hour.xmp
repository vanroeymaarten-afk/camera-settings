   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Blue sky, warm city lights: the classic teal-and-amber night look. White balance: Temp about 4000–4500 K keeps the sky blue while lights stay warm.</rdf:li>
    </rdf:Alt>
