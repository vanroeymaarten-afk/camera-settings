   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Soft, matte, film-like: olive greens, warm highlights and a little grain. White balance: Cloudy (6500 K) or As Shot +400 K to take the chill out of rain light.</rdf:li>
    </rdf:Alt>
   </crs:Description>
