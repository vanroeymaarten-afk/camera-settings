   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Clean, deep night skies with natural star colours and controlled noise. White balance: Set Temp to about 3900–4300 K and Tint +5 to +10 for a neutral blue-black sky.</rdf:li>
    </rdf:Alt>
   </crs:Description>
